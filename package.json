{
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.server.json",
    "check": "bun run build && tsc -p tests/tsconfig.contracts.json",
    "test": "bun test --timeout 30000",
    "start": "bun run server/main.ts",
    "dev": "bun run build && bun run start",
    "build:bin": "bun build --compile server/main.ts --outfile release/shepherd",
    "check:config": "bun run server/main.ts --check-config"
  },
  "dependencies": {
    "discord.js": "^14.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
