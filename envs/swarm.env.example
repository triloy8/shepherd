# Enabled only when SHEPHERD_SURFACES includes swarm in common.env.
# Same private-network operator trust model as web; never expose publicly.
# Listener is always 127.0.0.1, with separate state/handles from the web surface.
SHEPHERD_SWARM_PORT=8789
# Exact private HTTPS origins, comma-separated. Loopback origins are automatic.
SHEPHERD_SWARM_ORIGINS=
# Optional absolute path. Default: ~/.shepherd/swarm-groups
# Separate from the swarm skill helper's legacy manifests.
# SHEPHERD_SWARM_STATE_DIR=/absolute/path/to/swarm-groups
