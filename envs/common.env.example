# Shared runtime configuration used by all adapters
# Comma-separated selection: discord, web, or discord,web. Web requires envs/web.env.
SHEPHERD_SURFACES=discord
CODEX_MODEL=gpt-6.1-sol
# Claude is selected per conversation in the web UI.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=sonnet
# SHEPHERD_CLAUDE_STATE_DIR=/absolute/path/to/claude-state
# CLAUDE_EXECUTABLE=/absolute/path/to/claude
# New conversations default to medium reasoning effort.
CODEX_APPROVAL_POLICY=never
# Optional: read-only | workspace-write | danger-full-access
CODEX_SANDBOX=danger-full-access
# Optional: per-command deployment timeout in milliseconds (default: 30 minutes)
# SHEPHERD_DEPLOY_COMMAND_TIMEOUT_MS=1800000

# Optional volatile localhost signal webhook (disabled by default)
# SHEPHERD_SIGNAL_WEBHOOK_ENABLED=false
# SHEPHERD_SIGNAL_WEBHOOK_HOST=127.0.0.1
# SHEPHERD_SIGNAL_WEBHOOK_PORT=8787
# SHEPHERD_SIGNAL_WEBHOOK_MAX_BODY_BYTES=65536
# SHEPHERD_SIGNAL_QUEUE_CAPACITY=100
