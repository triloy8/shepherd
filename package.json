{
  "type": "module",
  "scripts": {
    "build": "bun run build:ui && tsc -p tsconfig.server.json",
    "check": "bun run build && tsc -p tests/tsconfig.contracts.json",
    "test": "bun test --timeout 30000",
    "start": "bun run server/main.ts",
    "dev": "bun run build && bun run start",
    "build:bin": "bun run build:ui && bun run scripts/build-binary.ts",
    "check:config": "bun run server/main.ts --check-config",
    "build:ui": "tsc -p ui/tsconfig.json && bun run --bun vite build --config ui/vite.config.ts",
    "dev:ui": "bun run --bun vite --config ui/vite.config.ts"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^7.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0"
  }
}
