# Web API is enabled only when SHEPHERD_SURFACES includes web in common.env.
# No application authentication: all reachable clients have operator access.
# Restrict remote access with tailnet policy and private Serve; never Funnel.
# Listener is always 127.0.0.1. Use private Tailscale Serve for remote access.
SHEPHERD_WEB_PORT=8788
# Exact remote browser origins, comma-separated. The listener's loopback origins are automatic.
# Use the private Serve HTTPS origin here; HTTP is allowed only for loopback development.
SHEPHERD_WEB_ORIGINS=
