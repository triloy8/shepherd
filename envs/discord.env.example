# Discord adapter configuration
DISCORD_BOT_TOKEN=your-discord-bot-token

# Discord uses typing, tool progress, and completed commentary for live feedback.
# Final-answer token streaming is disabled by default to avoid edit flicker.
# SHEPHERD_DISCORD_STREAMING=false

# Required when SHEPHERD_SIGNAL_WEBHOOK_ENABLED=true. Signals target the
# channel's current in-memory thread binding.
# SHEPHERD_RESEARCH_SIGNAL_DISCORD_CHANNEL_ID=123456789012345678
