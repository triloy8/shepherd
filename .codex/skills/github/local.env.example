EXPECTED_GITHUB_LOGIN=your-github-login
EXPECTED_GIT_USER_NAME=your-git-user-name
EXPECTED_GIT_USER_EMAIL=your-github-noreply-email
ALLOWED_REPOS=owner/repo-one,owner/repo-two
OWNER_REPO_DIRECT_PUSH=enabled
PROTECTED_BRANCHES=main,master
MERGE_STRATEGY=squash
ACTIVE_REPO_PATH=$HOME/path/to/active-repo
AGENT_WORKSPACE_ROOT=$HOME/.agent-workspaces
